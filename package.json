{
  "name": "lyric",
  "productName": "LYRIC",
  "version": "1.0.2",
  "description": "LYRIC - LYRIC YOUR SONGS",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis --publish never"
  },
  "build": {
    "appId": "com.lyric.player",
    "productName": "LYRIC",
    "files": ["main.js", "index.html"],
    "win": {
      "icon": "icon.png",
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "installer.nsh",
      "multiLanguageInstaller": true,
      "installerLanguages": ["vi_VN", "en_US"],
      "displayLanguageSelector": true,
      "artifactName": "LYRIC-Setup-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "33.2.0",
    "electron-builder": "25.1.8"
  }
}
