{
  "name": "lyric",
  "productName": "LYRIC",
  "version": "1.0.0",
  "description": "LYRIC - LYRIC YOUR SONGS",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis --publish never"
  },
  "build": {
    "appId": "com.lyric.player",
    "productName": "LYRIC",
    "files": ["main.js", "preload.js", "index.html"],
    "fileAssociations": [
      {
        "ext": ["mp3", "flac", "wav", "m4a", "ogg", "opus", "aac"],
        "name": "Audio file",
        "description": "Audio file"
      }
    ],
    "win": {
      "icon": "icon.png",
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "installer.nsh",
      "multiLanguageInstaller": true,
      "installerLanguages": ["vi_VN", "en_US"],
      "displayLanguageSelector": true,
      "artifactName": "LYRIC-Setup-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "33.2.0",
    "electron-builder": "25.1.8"
  }
}
